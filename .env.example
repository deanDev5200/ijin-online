# PostgreSQL connection string.
# Development uses the PostgreSQL 18 server on port 5432.
# URL-encode special characters in the password (for example @ -> %40).
# Use a dedicated, least-privilege role instead of "postgres" in production.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/ijin_online?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Initial admin account created by `npm run db:seed`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="123456"
ADMIN_FULL_NAME="Administrator"

# Public branding.
NEXT_PUBLIC_SCHOOL_NAME="Sekolah Asrama"
NEXT_PUBLIC_APP_NAME="Ijin Online"

# Set to "true" to create demo users when seeding.
SEED_DEMO="false"
